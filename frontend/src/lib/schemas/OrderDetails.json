{
    "$defs": {
        "AdminOrderItem": {
            "properties": {
                "name": {
                    "type": "string"
                },
                "quantity": {
                    "type": "integer"
                },
                "unitAmount": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Money"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "imageUrl": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "required": [
                "name",
                "quantity"
            ],
            "type": "object"
        },
        "Money": {
            "properties": {
                "currencyCode": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            },
            "required": [
                "currencyCode",
                "value"
            ],
            "type": "object"
        },
        "OrderCustomer": {
            "properties": {
                "name": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                }
            },
            "required": [
                "name",
                "email"
            ],
            "type": "object"
        },
        "OrderStatus": {
            "enum": [
                "CREATED",
                "SAVED",
                "APPROVED",
                "VOIDED",
                "COMPLETED",
                "PAYER_ACTION_REQUIRED",
                "PENDING",
                "CAPTURE_PENDING",
                "REFUND_PENDING",
                "REFUNDED"
            ],
            "type": "string"
        },
        "ShippingAddress": {
            "properties": {
                "addressLine1": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "addressLine2": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "city": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "region": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "postalCode": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "countryCode": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "type": "object"
        }
    },
    "properties": {
        "id": {
            "type": "string"
        },
        "createTime": {
            "format": "date-time",
            "type": "string"
        },
        "items": {
            "items": {
                "$ref": "#/$defs/AdminOrderItem"
            },
            "type": "array"
        },
        "total": {
            "anyOf": [
                {
                    "$ref": "#/$defs/Money"
                },
                {
                    "type": "null"
                }
            ],
            "default": null
        },
        "customer": {
            "$ref": "#/$defs/OrderCustomer"
        },
        "shippingAddress": {
            "anyOf": [
                {
                    "$ref": "#/$defs/ShippingAddress"
                },
                {
                    "type": "null"
                }
            ],
            "default": null
        },
        "recordId": {
            "type": "integer"
        },
        "status": {
            "$ref": "#/$defs/OrderStatus"
        }
    },
    "required": [
        "id",
        "createTime",
        "items",
        "customer",
        "recordId",
        "status"
    ],
    "type": "object"
}